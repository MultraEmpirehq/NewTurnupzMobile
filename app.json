{
  "expo": {
    "name": "Turnupz",
    "owner": "turnupz",
    "slug": "turnupz",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/65d8cfb7-9222-4f1f-bf8a-e7289613f888",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./src/shared/assets/images/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#f7fbff",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.turnupz.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/shared/assets/images/adaptive-icon.png",
        "backgroundImage": "./src/shared/assets/images/adaptive-background.png",
        "monochromeImage": "./src/shared/assets/images/monochrome-icon.png",
        "backgroundColor": "#8968C3"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.turnupz.app",
      "versionCode": 2,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./src/shared/assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "onesignal-expo-plugin",
        {
          "mode": "production"
        }
      ],
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Turnupz uses your location to show you events near you."
        }
      ],
      "./plugins/with-pod-deployment-target",
      "./plugins/with-android-release-signing"
    ],
    "extra": {
      "eas": {
        "projectId": "65d8cfb7-9222-4f1f-bf8a-e7289613f888"
      }
    }
  }
}
